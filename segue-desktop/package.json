{
  "name": "segue-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop music player",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently -k \"pnpm:dev:renderer\" \"pnpm:dev:electron\"",
    "dev:renderer": "ng serve",
    "dev:electron": "wait-on tcp:4200 && cross-env SEGUE_DEV_SERVER_URL=http://localhost:4200 electron .",
    "build": "ng build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package": "pnpm run build && pnpm run rebuild:native && electron-builder"
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "better-sqlite3": "^12.4.1",
    "chokidar": "^4.0.3",
    "essentia.js": "^0.1.3",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "typescript": "~5.8.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.segue.player",
    "productName": "segue",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
