{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "segue-desktop": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "essentia-wasm.web.js", "input": "node_modules/essentia.js/dist", "output": "assets/essentia" },
              { "glob": "essentia-wasm.web.wasm", "input": "node_modules/essentia.js/dist", "output": "" },
              { "glob": "essentia.js-core.js", "input": "node_modules/essentia.js/dist", "output": "assets/essentia" }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "segue-desktop:build:development" },
            "production": { "buildTarget": "segue-desktop:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
